{
  "name": "codeautopsy",
  "version": "0.2.2",
  "description": "Post-mortem analysis of dead GitHub repos",
  "type": "module",
  "bin": {
    "codeautopsy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "codeautopsy",
    "github",
    "dead-repos",
    "post-mortem",
    "analysis",
    "shipcli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lackim/codeautopsy.git"
  },
  "homepage": "https://lackim.github.io/codeautopsy/",
  "bugs": {
    "url": "https://github.com/lackim/codeautopsy/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/set-executable.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm web:build",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "web:build": "pnpm --dir web build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "dependencies": {
    "@shipcli/core": "^0.5.1",
    "@shipcli/share": "^0.5.1",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@shipcli/cli": "^0.5.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "fflate": "0.7.5"
    }
  }
}
